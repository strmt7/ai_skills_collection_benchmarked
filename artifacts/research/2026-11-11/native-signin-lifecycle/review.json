  "findings": [
    {
      "id": "write-generation-check",
      "evidence": "Pinned source and native conflict control",
      "conclusion": "Native persistence locks the read/modify/write and compares expected access/refresh generations. The injected newer generation was preserved."
    },
    {
      "id": "jwt-expiry-precedence",
      "evidence": "Pinned source and retained failed refresh1 attempt",
      "conclusion": "A parseable access-token JWT expiry takes precedence over last_refresh; aging only last_refresh does not force a refresh."
    },
    {
      "id": "cancellation-uncertainty",
      "evidence": "Native refresh-cancel control",
      "conclusion": "The simulated authority rotated before its delayed reply; the native process timed out with unchanged local credentials and zero owned children. An unchanged cache cannot establish that the authority grant is unchanged. The attempt stayed unscored."
    },
    {
      "id": "account-read-not-refresh-proof",
      "evidence": "Pinned source inspection only; not native RPC qualification",
      "conclusion": "account/read requests refreshToken, but its implementation discards RefreshTokenRequestOutcome before assembling account data. A successful account response alone is insufficient proof of a successful refresh. Do not adopt it as that proof without independent controls."
    }
  ],
