  "findings": [
    "Transient refresh failure returned a ChatGPT account without persisting refreshed credentials. Account presence is not refresh proof.",
    "Permanent refresh rejection returned a null account rather than a JSON-RPC error. The assessment must inspect account data.",
    "The production checker requires explicit ordinary-usage permission, stable account binding before/after metadata reads, a complete model inventory and the requested reasoning effort.",
    "Production raw stdout/stderr and account details stay in bounded memory; output retains sanitized decisions, source identities and process results. No token export or Reserve operation is requested.",
    "App-server reads the selected profile configuration; exec --ignore-user-config uses a different loading contract. Configuration concordance remains unproved and is explicitly false in metadata results.",
    "Workspace-routing identity and quota identity are version-bound observed native fields. Missing identity is unconfirmed readiness; broader SDK or cross-version compatibility is not established."
  ],
  "fixture_scope": "Synthetic file-store credentials and local HTTP endpoints only. HTTPS loopback routing is returned as metadata; TLS, real cloud routing and real account/keyring behavior are not qualified.",
  "retained_failures": [
    {
      "attempt": "native-account-rpc-success-v1",
      "finding": "Refresh succeeded but the old fixture lacked workspace discovery; not counted as account readiness."
    },
    {
      "attempt": "provider-route-unit-qualified-readiness1",
      "finding": "Test annotations failed mypy; fixed without suppressions and requalified."
    },
    {
      "attempt": "native-account-qualified-v1",
      "finding": "Three fresh-output checks collided with earlier exploratory directories. Old evidence was preserved; case outputs now use a separate namespace."
    }
