{
  "schema_version": 1,
  "controls": {
    "unsigned-clean": {
      "admitted": false,
      "mode": "unclassified",
      "process": {
        "windows_job": true,
        "assigned_before_resume": true,
        "kill_on_close": true,
        "job_active_processes_after_cleanup": 0,
        "service_created_processes_tracked": false,
        "termination_reason": null,
        "exit_code": 1,
        "output_bytes": 14,
        "output_limit_bytes": 65536,
        "wall_time_limit_seconds": 20.0,
        "job_memory_limit_bytes": 1073741824,
        "job_peak_memory_used_bytes": 8900608,
        "active_process_limit": 8,
        "explicit_environment": true,
        "write_io_limit_bytes": 1048576,
        "job_write_io_bytes": 540,
        "write_io_overshoot_bytes": 0,
        "write_io_observation_error": null,
        "write_io_enforcement": "polled_job_transfer_accounting",
        "hard_storage_quota": false
      }
    },
    "unsigned-with-rule": {
      "admitted": false,
      "mode": "not_checked",
      "reason": "global_rules_present"
    }
  },
  "scratch_removed": true,
  "model_attempts": 0
}
