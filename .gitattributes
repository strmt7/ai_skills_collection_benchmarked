# Owned tooling and generated metadata must satisfy the same LF checks on
# Windows and Linux. Do not apply repository-wide conversions to source mirrors.
/tools/** text eol=lf
/tests/** text eol=lf
/.github/** text eol=lf
/data/*.json text eol=lf
/included/improved/** text eol=lf
# This repair is generated from canonical locked source bytes on every host.
/included/repaired/skills/citation-management-security/** text eol=lf
/included/repaired/skills/citation-management-security/provenance/** -text
# The Key Vault repair preserves canonical source and license bytes.
/included/repaired/skills/azure-keyvault-java-security/** text eol=lf
/included/repaired/skills/azure-keyvault-java-security/provenance/** -text
/benchmarks/agent-effectiveness/** text eol=lf
# A frozen protocol is exact-byte evidence already bound into recorded trials.
/benchmarks/agent-effectiveness/development/protocol-v2.json -text
/benchmarks/dependency-regressions/** text eol=lf
# Captured crypto inputs are already bound by exact-byte research receipts.
/benchmarks/dependency-regressions/wycheproof-inputs.json -text
# Authored frontend controls use LF; captured inputs and native output stay exact.
/benchmarks/component-controls/frontend/** text eol=lf
/benchmarks/component-controls/frontend/fixtures/** -text
/benchmarks/component-controls/frontend/native/** -text
# Exact npm Windows captures are bound into the qualified dependency receipt.
/benchmarks/component-controls/frontend/package.json -text
/benchmarks/component-controls/frontend/package-lock.json -text
# Backend controllers are authored text; retained native streams are exact bytes.
/benchmarks/component-controls/backend/** text eol=lf
/benchmarks/component-controls/backend/native/** -text
# Native fixtures and summaries are authored text; upstream provenance stays exact.
/benchmarks/component-controls/native-testing/** text eol=lf
/included/repaired/skills/address-sanitizer-current/** text eol=lf
/included/repaired/skills/fuzzing-dictionary-current/** text eol=lf
/included/repaired/skills/address-sanitizer-current/provenance/** -text
/included/repaired/skills/fuzzing-dictionary-current/provenance/** -text
# The poster repair manifest is hash-bound; preserve original provenance bytes.
/included/repaired/skills/by-category/science-research-data-analysis/latest-release-community/latex-posters/** text eol=lf
/included/repaired/skills/by-category/science-research-data-analysis/latest-release-community/latex-posters/provenance/** -text !eol
/artifacts/repaired-skill-readiness/poster-preflight-v1/** text eol=lf
# Trial evidence hashes describe exact captured bytes, including Windows logs.
# Preserve them across Git transports instead of converting line endings.
/artifacts/agent-trials/** -text
/artifacts/research/** -text
/artifacts/source-notices/** -text
/artifacts/source-history/** -text
# Confined evaluator observations and their runtime pin bind exact Windows bytes.
/artifacts/component-controls/appcontainer/** -text
# Historical evaluator source snapshots are bound to exact captured bytes.
/artifacts/component-controls/appcontainer-source-snapshots/**/*.txt -text
/toolchains/appcontainer/source.json -text
/toolchains/appcontainer/README.md text eol=lf
/toolchains/appcontainer-modern/** text eol=lf
# Original provenance is an exact captured input, not authored source formatting.
/included/improved/**/provenance/** -text
/docs/** text eol=lf
/README.md text eol=lf
/AGENTS.md text eol=lf
/pyproject.toml text eol=lf
# Licensed build inputs and qualified wheel hashes require exact source bytes.
/toolchains/crawl4ai/** text eol=lf
/toolchains/crawl4ai/vendor/** -text
/toolchains/cocoindex-code/** text eol=lf
/toolchains/pptx-native/** text eol=lf
# Frozen source-resolution evidence is hashed as exact published bytes.
/artifacts/external-benchmark-integrations/skillsbench-source-resolution-v3/** -text
/artifacts/external-benchmark-integrations/skillsbench-source-resolution-v6/** -text
# This authored schema is bound by the native schema-validation receipt.
/evaluators/external_benchmark_method_smoke.schema.json text eol=lf
